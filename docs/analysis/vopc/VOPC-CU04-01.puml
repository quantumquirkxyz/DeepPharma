@startuml VOPC-CU04-01
allowmixing
title VOPC-CU04-01 — Consultar alertas críticas

left to right direction
skinparam shadowing false

actor "Farmacéutico" as Actor

package "Boundary" {
  class PantallaAlertasPriorizadas
}

package "Control" {
  class ControlConsultaAlertas
}

package "Entity" {
  class AlertaDesabastecimiento
  class PrediccionRiesgo
  class InventarioActual
  class Medicamento
  class CentroSalud
}

Actor --> PantallaAlertasPriorizadas
PantallaAlertasPriorizadas --> ControlConsultaAlertas
ControlConsultaAlertas --> AlertaDesabastecimiento
ControlConsultaAlertas --> PrediccionRiesgo
ControlConsultaAlertas --> InventarioActual
ControlConsultaAlertas --> Medicamento
ControlConsultaAlertas --> CentroSalud

note bottom
  VOPC: vista de clases participantes de ESC-CU04-01.
  No contiene mensajes numerados; esos pertenecen a DCOL-CU04-01.
  La priorización debe derivarse de reglas aprobadas.
end note
@enduml
