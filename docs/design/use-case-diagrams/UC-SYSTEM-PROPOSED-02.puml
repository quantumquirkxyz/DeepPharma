@startuml UC-SYSTEM-PROPOSED-02
title UC-SYSTEM-PROPOSED-02 — Modelo general de casos de uso de DeepPharma

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "ACT-01\nAdministrador del sistema" as ACT01
actor "ACT-02\nFarmacéutico" as ACT02
actor "ACT-03\nIngeniero de ML" as ACT03
actor "ACT-05\nAdministrador de farmacia" as ACT05
actor "EXT-01\nSALMI / fuente externa" as EXT01
actor "EXT-02\nPortal de Datos Abiertos" as EXT02
actor "EXT-03\nServicio de notificaciones" as EXT03

rectangle "Sistema DeepPharma" {
  package "Gestión de datos" {
    usecase "CU-01\nRegistrar datos históricos" as CU01
    usecase "CU-07\nValidar datos de inventario" as CU07
    usecase "CU-08\nPreprocesar datos históricos" as CU08
    usecase "CU-09\nSincronizar inventario\ncon fuente externa" as CU09
