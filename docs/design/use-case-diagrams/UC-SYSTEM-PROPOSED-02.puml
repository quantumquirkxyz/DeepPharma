    usecase "CU-10\nEvaluar modelos\npredictivos" as CU10
    usecase "CU-11\nRegistrar modelo\naprobado" as CU11
    usecase "CU-12\nConsultar explicación\nde predicción" as CU12
  }

  package "Inventario y alertas" {
    usecase "CU-04\nVisualizar y gestionar\nalertas priorizadas" as CU04
    usecase "CU-05\nGestionar inventario\nen tiempo real" as CU05
    usecase "CU-13\nConsultar inventario\nactual" as CU13
    usecase "CU-14\nConsultar detalle\nde alerta" as CU14
    usecase "CU-15\nReconocer o gestionar\nuna alerta" as CU15
    usecase "CU-16\nNotificar riesgo\ncrítico" as CU16
    usecase "CU-17\nGenerar reportes de\ninventario y riesgo" as CU17
  }

  package "Administración" {
    usecase "CU-18\nAdministrar usuarios\ny roles" as CU18
    usecase "CU-19\nConfigurar fuentes\ne integraciones" as CU19
  }
}

